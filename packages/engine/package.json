{
  "name": "@rectangles/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.src.json",
    "test": "vitest run --project fast",
    "test:slow": "vitest run --project slow",
    "test:all": "vitest run",
    "test:changed": "vitest run --project fast --changed",
    "test:watch": "vitest --project fast",
    "bench": "node bench/run-benchmarks.ts"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@fast-check/vitest": "^0.5.0",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "fast-check": "^4.10.2",
    "tinybench": "^6.2.2",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
